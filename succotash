        for obj, box in pairs(WorldESP.Windows) do
            if obj and obj:IsDescendantOf(workspace) then
                local primaryPart = obj:IsA("BasePart") and obj or obj.PrimaryPart
                if primaryPart then
                    local pos, onScreen = Camera:WorldToViewportPoint(primaryPart.Position)
                    if onScreen and pos.Z > 0 then
                        local size = primaryPart.Size
                        local width = 1000 / pos.Z * size.X
                        local height = 1000 / pos.Z * size.Y
                        box.Position = Vector2.new(pos.X - width / 2, pos.Y - height / 2)
                        box.Size = Vector2.new(width, height)
                        box.Color = Color3.fromRGB(255, 0, 255) -- Magenta for Windows
                        box.Visible = true
                    else
                        box.Visible = false
                    end
                else
                    box.Visible = false
                end
            else
                box.Visible = false
            end
        end
    else
        for _, box in pairs(WorldESP.Windows) do
            box.Visible = false
        end
    end
end)
