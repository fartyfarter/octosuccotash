                        if killer:IsA("Model") then
                            local humanoid = killer:FindFirstChild("Humanoid")
                            if humanoid then
                                local currentTime = tick()
                                if killerDebounce[killer] and currentTime - killerDebounce[killer] < 0.5 then continue end
                                local detected = false
                                for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
                                    local animId = track.Animation.AnimationId
                                    if animId == "rbxassetid://119181003138006" or animId == "rbxassetid://131430497821198" then
                                        detected = true
                                        break
                                    end
                                end
                                if detected then
                                    killerDebounce[killer] = currentTime
                                    local rootPart = killer:FindFirstChild("HumanoidRootPart")
                                    if rootPart then
                                        local part = Instance.new("Part")
                                        part.Size = Vector3.new(5, 5, 2000)
                                        part.Material = Enum.Material.ForceField
                                        part.CanCollide = false
                                        part.Transparency = 0.5
                                        part.Anchored = true
