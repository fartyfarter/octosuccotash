local function setupGeneratorESP(model)
    if not ESPEnabled then return end
    
    for _, espData in ipairs(ESPObjects) do
        if espData.model == model then return end
    end
    
    clearESP(model)
    
    local progress = model:FindFirstChild("Progress")
    local highlight = createHighlight(model, ESPColors.GeneratorFill, ESPColors.GeneratorOutline)
    
    local primaryPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if primaryPart then
        local displayText = model.Name
        if progress then
            displayText = model.Name .. "\nProgress: " .. tostring(progress.Value)
        end
        
        local combinedGui = createBillboardGui(primaryPart, displayText, Vector3.new(0, 3, 0), ESPColors.GeneratorOutline)
        
        if progress then
            local progressConnection
            progressConnection = progress:GetPropertyChangedSignal("Value"):Connect(function()
                if not ESPEnabled then
                    progressConnection:Disconnect()
                    return
                end
                local textLabel = combinedGui:FindFirstChild("TextLabel")
                
                if progress.Value >= 100 then
                    highlight.FillColor = ESPColors.GeneratorCompleteFill
                    highlight.OutlineColor = ESPColors.GeneratorCompleteOutline
                    if textLabel then
                        textLabel.Text = model.Name .. "\nProgress: " .. tostring(progress.Value)
                        textLabel.TextColor3 = ESPColors.GeneratorCompleteOutline
                    end
                else
                    highlight.FillColor = ESPColors.GeneratorFill
                    highlight.OutlineColor = ESPColors.GeneratorOutline
                    if textLabel then
                        textLabel.Text = model.Name .. "\nProgress: " .. tostring(progress.Value)
                        textLabel.TextColor3 = ESPColors.GeneratorOutline
                    end
                end
            end)
            
            if progress.Value >= 100 then
                highlight.FillColor = ESPColors.GeneratorCompleteFill
                highlight.OutlineColor = ESPColors.GeneratorCompleteOutline
                local textLabel = combinedGui:FindFirstChild("TextLabel")
                if textLabel then
                    textLabel.TextColor3 = ESPColors.GeneratorCompleteOutline
                end
            end
            
            table.insert(ESPObjects, {model = model, highlight = highlight, connections = {progressConnection}, type = "Generator"})
        else
            table.insert(ESPObjects, {model = model, highlight = highlight, connections = {}, type = "Generator"})
        end
    end
end

