local function scanForObjects()
    if not ESPEnabled then return end
    
    for i = #ESPObjects, 1, -1 do
        local espData = ESPObjects[i]
        if not espData.model or not espData.model.Parent then
            if espData.highlight then
                espData.highlight:Destroy()
            end
            for _, connection in ipairs(espData.connections) do
                connection:Disconnect()
            end
            clearESP(espData.model)
            table.remove(ESPObjects, i)
        end
    end
    
    local playersFolder = Workspace:FindFirstChild("Players")
    local survivors = playersFolder and playersFolder:FindFirstChild("Survivors")
    if survivors then
        for _, model in ipairs(survivors:GetChildren()) do
            if model:IsA("Model") then
                setupSurvivorESP(model)
            end
        end
    end
    
    local killers = playersFolder and playersFolder:FindFirstChild("Killers")
    if killers then
        for _, model in ipairs(killers:GetChildren()) do
            if model:IsA("Model") then
                setupKillerESP(model)
            end
        end
    end
    
    local mapFolder = Workspace:FindFirstChild("Map")
    local ingame = mapFolder and mapFolder:FindFirstChild("Ingame")
    if ingame then
        for _, model in ipairs(ingame:GetChildren()) do
            if model:IsA("Model") then
                if model.Name == "BloxyCola" or model.Name == "Medkit" then
                    setupItemESP(model, "Item")
                elseif model.Name == "Shockwave" then
                    setupNewItemESP(model, "Mass Infection")
                elseif model.Name == "Swords" then
                    setupNewItemESP(model, "Entanglement")
                elseif model.Name == "HumanoidRootProjectile" then
                    setupNewItemESP(model, "HumanoidRootProjectile")
                elseif model.Name == "PizzaDeliveryRig" or model.Name == "Minion1" or model.Name == "Minion2" or model.Name == "Minion3" or
                       model.Name == "Mafia1" or model.Name == "Mafia2" or model.Name == "Mafia3" or model.Name == "Mafia4" then
                    setupCoolkidMinionESP(model)
                elseif model.Name == "007n7" then
                    setupClone007n7ESP(model)
                elseif type(model.Name) == "string" and string.find(model.Name, "RespawnLocation") then
                    setupRitualESP(model)
                elseif model.Name == "Generator" then
                    setupGeneratorESP(model)
                elseif model.Name == "FakeGenerator" then
                    setupFakeGeneratorESP(model)
                end
            end
        end
        
        for _, child in ipairs(ingame:GetChildren()) do
            if child:IsA("Folder") and string.find(child.Name, "Shadows") then
                for _, model in ipairs(child:GetChildren()) do
                    if model:IsA("Model") and string.find(model.Name, "Shadow") then
                        setupFootprintESP(model)
                    end
                end
            end
        end
        
        for _, model in ipairs(ingame:GetDescendants()) do
            if model:IsA("Model") and model.Parent ~= ingame then
                if model.Name == "Shockwave" then
                    setupNewItemESP(model, "Mass Infection")
                elseif model.Name == "Swords" then
                    setupNewItemESP(model, "Entanglement")
                elseif model.Name == "HumanoidRootProjectile" then
                    setupNewItemESP(model, "HumanoidRootProjectile")
                elseif model.Name == "PizzaDeliveryRig" or model.Name == "Minion1" or model.Name == "Minion2" or model.Name == "Minion3" or
                       model.Name == "Mafia1" or model.Name == "Mafia2" or model.Name == "Mafia3" or model.Name == "Mafia4" then
                    setupCoolkidMinionESP(model)
                elseif model.Name == "007n7" then
                    setupClone007n7ESP(model)
                elseif string.find(model.Name, "RespawnLocation") then
                    setupRitualESP(model)
                end
            end
        end
        
        local map = ingame:FindFirstChild("Map")
        if map then
            for _, model in ipairs(map:GetChildren()) do
                if model:IsA("Model") then
                    if model.Name == "BloxyCola" or model.Name == "Medkit" then
                        setupItemESP(model, "Item")
                    elseif model.Name == "Generator" then
                        setupGeneratorESP(model)
                    elseif model.Name == "FakeGenerator" then
                        setupFakeGeneratorESP(model)
                    end
                end
            end
            
            for _, model in ipairs(map:GetDescendants()) do
                if model:IsA("Model") and model.Parent ~= map then
                    if model.Name == "Generator" then
                        setupGeneratorESP(model)
                    elseif model.Name == "FakeGenerator" then
                        setupFakeGeneratorESP(model)
                    end
                end
            end
        end
    end
end

local function clearAllESP()
    for _, espData in ipairs(ESPObjects) do
        if espData.highlight then
            espData.highlight:Destroy()
        end
        for _, connection in ipairs(espData.connections) do
            connection:Disconnect()
        end
        clearESP(espData.model)
    end
    ESPObjects = {}
end

-- Device Simulation Function
local function applyDeviceSimulation()
    if not DeviceSimulationEnabled then return end
    
    if SelectedDevice == "Console" then
        UserInputService.TouchEnabled = false
        UserInputService.GamepadEnabled = true
        UserInputService.MouseEnabled = false
    elseif SelectedDevice == "PC" then
        UserInputService.TouchEnabled = false
        UserInputService.GamepadEnabled = false
        UserInputService.MouseEnabled = true
    elseif SelectedDevice == "Mobile" then
        UserInputService.TouchEnabled = true
        UserInputService.GamepadEnabled = false
        UserInputService.MouseEnabled = false
    end
end

local function resetDeviceSimulation()
    UserInputService.TouchEnabled = OriginalInputSettings.TouchEnabled
    UserInputService.GamepadEnabled = OriginalInputSettings.GamepadEnabled
    UserInputService.MouseEnabled = OriginalInputSettings.MouseEnabled
end

