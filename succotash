                        box.Size = Vector2.new(width, height)
                        box.Color = Color3.fromRGB(0, 255, 255) -- Cyan for Pallets
                        box.Visible = true
                    else
                        box.Visible = false
                    end
                else
                    box.Visible = false
                end
            else
                box.Visible = false
            end
        end
    else
        for _, box in pairs(WorldESP.Pallets) do
            box.Visible = false
        end
    end

    if Toggles.VD_WindowESP then
